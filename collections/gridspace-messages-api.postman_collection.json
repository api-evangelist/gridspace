        {
          "id": "b7bebe78-b988-42fd-8dd6-2447b630e9f7",
          "name": "List inbound messages",
          "request": {
            "name": "List inbound messages",
            "description": {
              "content": "List the inbound messages received on one of your Guava numbers, oldest first.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "messages"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "to_number",
                  "value": "<string>",
                  "description": "(Required) The Guava number whose inbox you want to read (E.164). Must be owned by your organization."
                },
                {
                  "disabled": false,
                  "key": "start",
                  "value": "<dateTime>",
                  "description": "Only return messages received at or after this time (ISO 8601, inclusive)."
                },
                {
                  "disabled": false,
                  "key": "from_number",
                  "value": "<string>",
                  "description": "Only return messages sent from this number (E.164)."
                },
                {
                  "disabled": false,
                  "key": "modality",
                  "value": "<string>",
                  "description": "Only return messages on this channel."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "50",
                  "description": "Maximum number of messages to return."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null

      "name": "messages",
      "item": [
        {
          "name": "List inbound messages",
          "id": "06a7b028-abb3-4469-8432-74b0ee3f39d3",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/messages?to_number=<string>&start=<dateTime>&from_number=<string>&modality=sms&limit=50",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "messages"
              ],
              "query": [
                {
                  "description": "(Required) The Guava number whose inbox you want to read (E.164). Must be owned by your organization.",
                  "key": "to_number",
                  "value": "<string>"
                },
                {
                  "description": "Only return messages received at or after this time (ISO 8601, inclusive).",
                  "key": "start",
                  "value": "<dateTime>"
                },
                {
                  "description": "Only return messages sent from this number (E.164).",
                  "key": "from_number",
                  "value": "<string>"
                },
                {
                  "description": "Only return messages on this channel.",
                  "key": "modality",
                  "value": "sms"
                },
                {
                  "description": "Maximum number of messages to return.",
                  "key": "limit",
                  "value": "50"
                }
              ]
            },
            "description": "List the inbound messages received on one of your Guava numbers, oldest first."
          },
